# HireAndTech local development configuration. Never put secrets in this file.

# App
HIREANDTECH_ENVIRONMENT=local
HIREANDTECH_LOG_LEVEL=INFO
HIREANDTECH_ALLOWED_HOSTS=["localhost","127.0.0.1"]
HIREANDTECH_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Database
HIREANDTECH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hireandtech
# Test database only. Never point this at production.
HIREANDTECH_TEST_DATABASE_URL=
HIREANDTECH_DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/hireandtech
HIREANDTECH_DATABASE_SSL_MODE=disable
# HIREANDTECH_DATABASE_SSL_CA_FILE=/path/to/database-ca.pem
HIREANDTECH_DATABASE_POOL_SIZE=5
HIREANDTECH_DATABASE_MAX_OVERFLOW=5
HIREANDTECH_DATABASE_POOL_TIMEOUT_SECONDS=5
HIREANDTECH_DATABASE_CONNECT_TIMEOUT_SECONDS=5
HIREANDTECH_DATABASE_STATEMENT_TIMEOUT_SECONDS=10

# Redis and queues
HIREANDTECH_REDIS_URL=redis://localhost:6379/0
HIREANDTECH_REDIS_CONNECT_TIMEOUT_SECONDS=5
HIREANDTECH_JOB_COLLECTION_QUEUE_NAME=hireandtech:jobs
HIREANDTECH_JOB_SEARCH_QUEUE_NAME=hireandtech:search

# Supabase authentication and private resume storage
# HIREANDTECH_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
HIREANDTECH_SUPABASE_JWT_AUDIENCE=authenticated
HIREANDTECH_SUPABASE_SECRET_KEY=
HIREANDTECH_RESUME_STORAGE_BUCKET=resumes
HIREANDTECH_RESUME_MAX_SIZE_BYTES=5242880
HIREANDTECH_RESUME_MAX_PAGES=25
HIREANDTECH_RESUME_MAX_EXTRACTED_CHARACTERS=200000
HIREANDTECH_RESUME_PARSER_VERSION=deterministic-v1
HIREANDTECH_RESUME_PARSE_TIMEOUT_SECONDS=10
HIREANDTECH_RESUME_MAX_CONCURRENT_PARSES=2

# Job collection
HIREANDTECH_JOB_COLLECTION_ENABLED=false
HIREANDTECH_DICE_COLLECTION_INTERVAL_MINUTES=30
HIREANDTECH_LINKEDIN_COLLECTION_INTERVAL_MINUTES=60
HIREANDTECH_GLASSDOOR_COLLECTION_INTERVAL_MINUTES=120
HIREANDTECH_HIRINGCAFE_COLLECTION_INTERVAL_MINUTES=30
HIREANDTECH_GLASSDOOR_COLLECTION_BATCH_SIZE=6
HIREANDTECH_GLASSDOOR_IMPERSONATE=chrome124
HIREANDTECH_JOB_COLLECTION_MAX_JOBS_PER_TARGET=100
HIREANDTECH_JOB_COLLECTION_LOCK_TTL_SECONDS=900
HIREANDTECH_JOB_COLLECTION_TASK_TIMEOUT_SECONDS=600
HIREANDTECH_JOB_COLLECTION_MAX_TRIES=3
HIREANDTECH_JOB_COLLECTION_REDIS_NAMESPACE=hireandtech
HIREANDTECH_JOB_COLLECTION_PROXY_URL=
# Optional JSON override of global collection targets.
# HIREANDTECH_JOB_COLLECTION_TARGETS=[{"source":"dice","query":"Backend Engineer","location":"United States","enabled":true,"max_jobs":100}]

# Security
HIREANDTECH_TRUSTED_PROXY_CIDRS=[]
HIREANDTECH_IP_ALLOWLIST_ENABLED=false
HIREANDTECH_IP_ALLOWLIST_FAIL_CLOSED=true
HIREANDTECH_IP_EMERGENCY_BYPASS_CIDRS=[]
HIREANDTECH_RATE_LIMIT_ENABLED=true
HIREANDTECH_RATE_LIMIT_FAIL_CLOSED=true
HIREANDTECH_RATE_LIMIT_WINDOW_SECONDS=60
HIREANDTECH_RATE_LIMIT_AUTH_REQUESTS=30
HIREANDTECH_RATE_LIMIT_ADMIN_SECURITY_REQUESTS=60
HIREANDTECH_RATE_LIMIT_RESUME_WRITE_REQUESTS=10
HIREANDTECH_RATE_LIMIT_MAX_KEYS=10000

# AI (planned; no runtime settings are currently consumed)
