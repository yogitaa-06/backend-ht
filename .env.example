# ===========================================================================
# HireAndTech Backend - Local Development
# ===========================================================================
# IMPORTANT:
# - This file is for LOCAL development only.
# - Do NOT commit .env to Git.
# - Do NOT put production secrets here.
# ===========================================================================


# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

HIREANDTECH_ENVIRONMENT=
HIREANDTECH_LOG_LEVEL=


# ---------------------------------------------------------------------------
# Network / Security
# ---------------------------------------------------------------------------

HIREANDTECH_ALLOWED_HOSTS=

HIREANDTECH_CORS_ALLOWED_ORIGINS=

# JSON arrays of IPv4/IPv6 CIDRs. Forwarding headers are trusted only when the
# immediate socket peer is listed here. Emergency CIDRs remain configuration-only.
HIREANDTECH_TRUSTED_PROXY_CIDRS=[]
HIREANDTECH_IP_ALLOWLIST_ENABLED=false
HIREANDTECH_IP_ALLOWLIST_FAIL_CLOSED=true
HIREANDTECH_IP_EMERGENCY_BYPASS_CIDRS=[]

# Bounded per-process Phase 4 rate-limiting foundation.
HIREANDTECH_RATE_LIMIT_ENABLED=true
HIREANDTECH_RATE_LIMIT_FAIL_CLOSED=true
HIREANDTECH_RATE_LIMIT_WINDOW_SECONDS=60
HIREANDTECH_RATE_LIMIT_AUTH_REQUESTS=30
HIREANDTECH_RATE_LIMIT_ADMIN_SECURITY_REQUESTS=60
HIREANDTECH_RATE_LIMIT_RESUME_WRITE_REQUESTS=10
HIREANDTECH_RATE_LIMIT_MAX_KEYS=10000




HIREANDTECH_DATABASE_URL=
HIREANDTECH_DATABASE_MIGRATION_URL=

# ---------------------------------------------------------------------------
# PostgreSQL TLS
# ---------------------------------------------------------------------------
# Local PostgreSQL does not require TLS.
#
# Production must NOT use disable.
# ---------------------------------------------------------------------------

HIREANDTECH_DATABASE_SSL_MODE=

# Only required when SSL mode is verify-full.
#
# HIREANDTECH_DATABASE_SSL_CA_FILE=/path/to/database-ca.pem


# ---------------------------------------------------------------------------
# PostgreSQL Connection Pool
# ---------------------------------------------------------------------------

HIREANDTECH_DATABASE_POOL_SIZE=

HIREANDTECH_DATABASE_MAX_OVERFLOW=

HIREANDTECH_DATABASE_POOL_TIMEOUT_SECONDS=

HIREANDTECH_DATABASE_CONNECT_TIMEOUT_SECONDS=

HIREANDTECH_DATABASE_STATEMENT_TIMEOUT_SECONDS=


# ---------------------------------------------------------------------------
# Supabase Authentication
# ---------------------------------------------------------------------------
# Supabase PROJECT URL only.
#
#
# ---------------------------------------------------------------------------

HIREANDTECH_SUPABASE_URL=

HIREANDTECH_SUPABASE_JWT_AUDIENCE=


# Resume security and parsing
HIREANDTECH_RESUME_STORAGE_BUCKET=resumes
HIREANDTECH_RESUME_MAX_SIZE_BYTES=5242880
HIREANDTECH_RESUME_MAX_PAGES=25
HIREANDTECH_RESUME_MAX_EXTRACTED_CHARACTERS=200000
HIREANDTECH_RESUME_PARSER_VERSION=deterministic-v1
HIREANDTECH_RESUME_PARSE_TIMEOUT_SECONDS=10
HIREANDTECH_RESUME_MAX_CONCURRENT_PARSES=2

# Backend-only Supabase credential. Never expose this to the frontend.
HIREANDTECH_SUPABASE_SECRET_KEY=

# Global collection is disabled by default in the API process. Enable it only
# in the dedicated worker deployment.
HIREANDTECH_JOB_COLLECTION_ENABLED=false
HIREANDTECH_REDIS_URL=redis://localhost:6379/0
HIREANDTECH_REDIS_CONNECT_TIMEOUT_SECONDS=5
HIREANDTECH_DICE_COLLECTION_INTERVAL_MINUTES=30
HIREANDTECH_LINKEDIN_COLLECTION_INTERVAL_MINUTES=30
HIREANDTECH_GLASSDOOR_COLLECTION_INTERVAL_MINUTES=30
HIREANDTECH_JOB_COLLECTION_MAX_JOBS_PER_TARGET=100
HIREANDTECH_JOB_COLLECTION_LOCK_TTL_SECONDS=900
HIREANDTECH_JOB_COLLECTION_TASK_TIMEOUT_SECONDS=600
HIREANDTECH_JOB_COLLECTION_MAX_TRIES=3
HIREANDTECH_JOB_COLLECTION_QUEUE_NAME=hireandtech:jobs
HIREANDTECH_JOB_COLLECTION_REDIS_NAMESPACE=hireandtech

# Optional JSON override. Targets are global platform queries and must never
# include user, resume, or candidate identifiers.
# HIREANDTECH_JOB_COLLECTION_TARGETS=[{"source":"dice","query":"DevOps Engineer","location":"United States","enabled":true,"max_jobs":100}]
