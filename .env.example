# Copy this file to .env for local development.
# Never commit real passwords, tokens, credentials, or production secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

HIREANDTECH_ENVIRONMENT=local
HIREANDTECH_LOG_LEVEL=INFO

HIREANDTECH_ALLOWED_HOSTS='["localhost","127.0.0.1","testserver"]'
HIREANDTECH_CORS_ALLOWED_ORIGINS='["http://localhost:3000"]'

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Application database connection.
#
# Replace admin1234 with your local PostgreSQL password in your private
# .env file only.
#
# Do NOT place a real password in .env.example.
HIREANDTECH_DATABASE_URL=postgresql://postgres:admin1234@localhost:5432/hireandtech

# Optional dedicated migration connection.
#
# Local development can use the same PostgreSQL connection as the API.
# Production may provide a separate privileged migration connection.
HIREANDTECH_DATABASE_MIGRATION_URL=postgresql://postgres:admin1234@localhost:5432/hireandtech

# TLS policy:
#
# local/test:
#   disable
#
# staging/production:
#   verify-full
#
# TLS must never be disabled for non-local environments.
HIREANDTECH_DATABASE_SSL_MODE=disable

# Required when DATABASE_SSL_MODE=verify-full and the deployment requires
# an explicit CA certificate.
#
# HIREANDTECH_DATABASE_SSL_CA_FILE=/path/to/database-ca.pem

# ---------------------------------------------------------------------------
# Database pool and timeout settings
# ---------------------------------------------------------------------------

HIREANDTECH_DATABASE_POOL_SIZE=5
HIREANDTECH_DATABASE_MAX_OVERFLOW=5
HIREANDTECH_DATABASE_POOL_TIMEOUT_SECONDS=5
HIREANDTECH_DATABASE_CONNECT_TIMEOUT_SECONDS=5
HIREANDTECH_DATABASE_STATEMENT_TIMEOUT_SECONDS=10